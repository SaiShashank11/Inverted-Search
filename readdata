#include "inverted_search.h"

word* read_datafile(FILE *file, word* wordlist, char *filename)
{
    if (file == NULL || filename == NULL) return wordlist;

    char ch;
    char buffer[MAX_WORD_SIZE];
    int idx = 0;

    while ((ch = fgetc(file)) != EOF) {
        if (isalpha(ch)) {
            if (idx < MAX_WORD_SIZE - 1) {
                buffer[idx++] = tolower(ch);
            }
        } else {
            if (idx > 0) {
                buffer[idx] = '\0';
                wordlist = store_word(buffer, filename, wordlist);
                idx = 0;
            }
        }
    }

    if (idx > 0) {
        buffer[idx] = '\0';
        wordlist = store_word(buffer, filename, wordlist);
    }

    return wordlist;
}